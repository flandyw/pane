diff --git a/client/Android/Studio/freeRDPCore/src/main/cpp/android_freerdp.c b/client/Android/Studio/freeRDPCore/src/main/cpp/android_freerdp.c
index 4855ff8..699de5c 100644
--- a/client/Android/Studio/freeRDPCore/src/main/cpp/android_freerdp.c
+++ b/client/Android/Studio/freeRDPCore/src/main/cpp/android_freerdp.c
@@ -857,7 +857,17 @@ JNIEXPORT void JNICALL Java_com_freerdp_freerdpcore_services_LibFreeRDP_freerdp_
 	freerdp* inst = (freerdp*)instance;
 
 	if (inst)
+	{
+		/* Join the native thread before freeing a context referenced by its callbacks. */
+		androidContext* ctx = (androidContext*)inst->context;
+		if (ctx->thread)
+		{
+			WaitForSingleObject(ctx->thread, INFINITE);
+			CloseHandle(ctx->thread);
+			ctx->thread = nullptr;
+		}
 		freerdp_client_context_free(inst->context);
+	}
 
 #if defined(WITH_GPROF)
 	moncleanup();
